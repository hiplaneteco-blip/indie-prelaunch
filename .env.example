# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set during dev for instant guild-scoped command registration.
# Leave blank once ready to register globally (takes up to 1h to propagate).
DISCORD_GUILD_ID=

# Postgres connection string, e.g. from Supabase (Settings > Database > Connection string)
DATABASE_URL=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
